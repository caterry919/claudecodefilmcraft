{
  "mcpServers": {
    "filmcraft": {
      "command": "target/release/filmcraft-cli",
      "args": ["mcp", "--bridge", "127.0.0.1:9876"]
    },
    "filmcraft-headless": {
      "command": "target/release/filmcraft-cli",
      "args": ["mcp", "--demo"]
    },
    "effectcraft": {
      "command": "/home/user/effectcraft/target/release/effectcraft-cli",
      "args": ["mcp", "--demo"]
    },
    "effectcraft-app": {
      "command": "/home/user/effectcraft/target/release/effectcraft-cli",
      "args": ["mcp", "--bridge", "9877"]
    }
  }
}
